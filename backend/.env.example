# Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false

# MongoDB (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/bank_management_system?replicaSet=rs0
REQUIRE_REPLICA_SET=true

# JWT - generate two different random values of at least 32 characters
JWT_ACCESS_SECRET=replace_with_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_EXPIRES_MS=604800000

# Initial administrator seed credentials (never commit real values)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_a_unique_password_at_least_12_characters
ADMIN_SEED_FULL_NAME=System Administrator

# SMTP is optional for local development. Configure it for real email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="NexaBank <no-reply@example.com>"

# Password reset token lifetime
RESET_PASSWORD_EXPIRES_MS=3600000

# Field-level encryption for KYC document numbers (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LOSING THIS KEY MAKES ENCRYPTED DATA UNRECOVERABLE - store it in a secrets manager, not in git.
KYC_ENCRYPTION_KEY=

# Encrypts database backups (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store it in a secrets manager SEPARATE from the backups. Losing it makes every backup unreadable.
BACKUP_ENCRYPTION_KEY=
