{
  "name": "bank-management-system-backend",
  "version": "1.0.0",
  "description": "Bank Management System backend with JWT auth, RBAC, audit logs, and transaction management",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seed.js",
    "test": "node --test",
    "indexes": "node src/utils/createIndexes.js",
    "migrate-money": "node src/utils/migrateMoney.js",
    "kyc:encrypt": "node scripts/encrypt-kyc.js",
    "test:e2e": "node --test test/e2e/bank.e2e.test.js",
    "docs:openapi": "node scripts/generate-openapi.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "check:login": "node scripts/check-login.js"
